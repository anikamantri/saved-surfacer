# Copy to .env (gitignored) and fill in.

# OpenAI — multimodal extraction (frames + transcript + caption) and audio transcription.
# The whole 14-post corpus costs well under a dollar to re-run.
OPENAI_API_KEY=sk-proj-...

# Google Maps — Places API (New) must be ENABLED on the project, with billing attached.
# Note the daily SearchTextRequest quota is per PROJECT, not per key: a new key on a
# project whose quota is exhausted inherits the same limit.
GOOGLE_MAPS_API_KEY=AIza...

# Optional overrides.
OPENAI_EXTRACT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
