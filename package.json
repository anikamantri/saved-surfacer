{
  "name": "saved-surfacer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cue \u2014 resurfaces saved social posts at the moment they become useful.",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "engine",
    "ingest",
    "app"
  ],
  "scripts": {
    "setup": "bash ingest/setup.sh",
    "ingest": "node ingest/run.mjs",
    "ingest:force": "node ingest/run.mjs --force",
    "geocode": "node ingest/05-geocode.mjs",
    "server": "node ingest/server.mjs",
    "dev": "npm --workspace @cue/app run dev",
    "build": "npm --workspace @cue/app run build",
    "app:sync": "npm --workspace app run sync",
    "test": "npm --workspace @cue/engine run test"
  }
}
